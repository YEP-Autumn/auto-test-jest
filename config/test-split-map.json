{
  "version": 1,
  "description": "把 UG 小节级别的扁平目录，按「子功能」下沉一层（feature/<模块>/<小节>/<子功能>）。groups 的顺序即文件分配顺序，count 为该组文件数（省略表示剩余全部）。",
  "renumber": { "start": 10, "step": 10, "width": 4 },
  "splits": [
    {
      "from": "test/feature/05-IP_ROUTE/01-ip_unicast_route",
      "token": "IP_ROUTE",
      "groups": [
        { "to": "01-ip_route_basic", "count": 2 },
        { "to": "02-ip_route_rnh", "count": 8 }
      ]
    },
    {
      "from": "test/feature/03-ETHERNET/09-vlan_mapping",
      "token": "ETHERNET",
      "groups": [
        { "to": "01-vlan_mapping", "count": 1 },
        { "to": "02-dot1q_tunnel", "count": 10 }
      ]
    },
    {
      "from": "test/feature/03-ETHERNET/03-l3_interface",
      "token": "ETHERNET",
      "groups": [{ "to": "01-vlan_subif" }]
    },
    {
      "from": "test/feature/19-MPLS/02-mpls",
      "token": "MPLS",
      "groups": [
        { "to": "01-mpls_basic", "count": 14 },
        { "to": "02-mpls_vlan_mapping", "count": 6 },
        { "to": "03-mpls_load_balance", "count": 18 },
        { "to": "04-mpls_ac_vlan_range", "count": 7 },
        { "to": "05-mpls_bpdu_ac", "count": 8 }
      ]
    },
    {
      "from": "test/feature/19-MPLS/02-mpls_cli",
      "token": "MPLS",
      "base": "test/feature/19-MPLS/02-mpls",
      "groups": [{ "to": "05-mpls_bpdu_ac_cli" }]
    },
    {
      "from": "test/feature/19-MPLS/02-mpls_spec",
      "token": "MPLS",
      "base": "test/feature/19-MPLS/02-mpls",
      "groups": [{ "to": "05-mpls_bpdu_ac_spec" }]
    },
    {
      "from": "test/feature/05-IP_ROUTE/07-bgp",
      "token": "IP_ROUTE",
      "groups": [{ "to": "01-bgp_multiple_instance" }]
    },
    {
      "from": "test/feature/03-ETHERNET/12-storm_control",
      "token": "ETHERNET",
      "groups": [
        { "to": "01-action_shutdown", "count": 8 },
        { "to": "02-action_trap", "count": 12 },
        { "to": "03-recovery_errdisable", "count": 1 }
      ]
    },
    {
      "from": "test/feature/10-TRAFFIC_MANAGEMENT/01-qos_cli",
      "token": "TRAFFIC_MANAGEMENT",
      "base": "test/feature/10-TRAFFIC_MANAGEMENT/01-qos",
      "groups": [
        { "to": "01-class_map_cli", "count": 4 },
        { "to": "02-policy_map_cli", "count": 6 },
        { "to": "03-application_cli", "count": 9 },
        { "to": "04-combination_cli", "count": 4 }
      ]
    }
  ]
}
